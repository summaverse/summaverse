---
const today = new Date();
---

<footer>
	<p class="brand">SUMMAVERSE</p>
	<p class="copy">&copy; {today.getFullYear()} Summaverse. All rights reserved.</p>
</footer>

<style>
	footer {
		background: #050505;
		border-top: 1px solid rgba(212, 168, 67, 0.2);
		padding: 3em 2em;
		text-align: center;
	}
	.brand {
		color: #d4a843;
		font-size: 1.1em;
		font-weight: 700;
		letter-spacing: 0.35em;
		margin: 0 0 0.5em;
	}
	.copy {
		color: #555;
		font-size: 0.8em;
		margin: 0;
		letter-spacing: 0.05em;
	}
</style>
