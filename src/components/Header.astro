---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="site-title">{SITE_TITLE}</a>
		<div class="nav-links">
			<a href="/">Home</a>
			<a href="/history">History</a>
			<a href="/contact">Contact</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: rgba(8, 8, 8, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(212, 168, 67, 0.25);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 68px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2em;
	}
	.site-title {
		font-size: 1.3em;
		font-weight: 700;
		color: #d4a843;
		text-decoration: none;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
	.site-title:hover {
		color: #e6bb55;
	}
	.nav-links {
		display: flex;
		gap: 2.5em;
	}
	.nav-links a {
		color: #d0d0d0;
		text-decoration: none;
		font-size: 0.85em;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transition: color 0.2s;
	}
	.nav-links a:hover {
		color: #d4a843;
	}
	@media (max-width: 600px) {
		.nav-links {
			gap: 1.2em;
		}
		.nav-links a {
			font-size: 0.75em;
		}
		.site-title {
			font-size: 1.1em;
		}
	}
</style>
