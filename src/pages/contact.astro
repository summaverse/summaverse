---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact — Summaverse" description="Get in touch with the Summaverse" />
	</head>
	<body>
		<Header />

		<div class="page">
			<div class="page-hero">
				<h1>Get in Touch</h1>
				<p class="subtitle">We'd love to hear from you</p>
			</div>

			<div class="content">
				<form class="contact-form" method="POST">
					<div class="field">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" placeholder="Your name" required />
					</div>
					<div class="field">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" placeholder="your@email.com" required />
					</div>
					<div class="field">
						<label for="subject">Subject</label>
						<input type="text" id="subject" name="subject" placeholder="What's on your mind?" />
					</div>
					<div class="field">
						<label for="message">Message</label>
						<textarea id="message" name="message" rows="6" placeholder="Tell us about your summit..." required></textarea>
					</div>
					<button type="submit">Send Message</button>
				</form>
			</div>
		</div>

		<Footer />
	</body>
</html>

<style>
	html, body { margin: 0; padding: 0; }

	.page {
		padding-top: 68px;
		min-height: 100vh;
		background: #0a0a0a;
		color: #fff;
	}
	.page-hero {
		text-align: center;
		padding: 5em 2em 3em;
		border-bottom: 1px solid rgba(212, 168, 67, 0.2);
		background: linear-gradient(180deg, #111 0%, #0a0a0a 100%);
	}
	.page-hero h1 {
		color: #fff;
		font-size: clamp(2rem, 5vw, 3.5rem);
		margin: 0 0 0.3em;
		letter-spacing: 0.05em;
	}
	.subtitle {
		color: #d4a843;
		font-size: 0.9em;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin: 0;
	}
	.content {
		max-width: 620px;
		margin: 0 auto;
		padding: 5em 2em 6em;
	}
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.6em;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	label {
		color: #d4a843;
		font-size: 0.75em;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		font-weight: 700;
	}
	input, textarea {
		background: #141414;
		border: 1px solid rgba(212, 168, 67, 0.25);
		color: #e5e5e5;
		padding: 0.85em 1em;
		border-radius: 6px;
		font-family: inherit;
		font-size: 0.95em;
		transition: border-color 0.2s, box-shadow 0.2s;
		resize: vertical;
		width: 100%;
	}
	input:focus, textarea:focus {
		outline: none;
		border-color: #d4a843;
		box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.1);
	}
	input::placeholder, textarea::placeholder {
		color: #444;
	}
	button {
		background: #d4a843;
		color: #080808;
		border: none;
		padding: 0.95em 2.5em;
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.2s, transform 0.15s;
		font-family: inherit;
		align-self: flex-start;
	}
	button:hover {
		background: #e6bb55;
		transform: translateY(-2px);
	}
	button:active {
		transform: translateY(0);
	}
</style>
