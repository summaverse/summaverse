---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="History — Summaverse" description="The story behind the Summaverse" />
	</head>
	<body>
		<Header />

		<div class="page">
			<div class="page-hero">
				<h1>Our History</h1>
				<p class="subtitle">How the Summaverse came to be</p>
			</div>

			<div class="content">
				<section class="timeline">
					<div class="timeline-item">
						<span class="year">2020</span>
						<div class="timeline-body">
							<h3>The Beginning</h3>
							<p>The Summaverse was born from a simple idea — that every person has a summit worth reaching. What started as a conversation became a movement built on shared ambition and genuine connection.</p>
						</div>
					</div>
					<div class="timeline-item">
						<span class="year">2022</span>
						<div class="timeline-body">
							<h3>Growing the Community</h3>
							<p>Connections were made, stories were shared, and a community began forming around shared values of growth, perseverance, and exploration. The Summaverse was no longer just an idea — it had a heartbeat.</p>
						</div>
					</div>
					<div class="timeline-item">
						<span class="year">2024</span>
						<div class="timeline-body">
							<h3>Expanding the Universe</h3>
							<p>New voices, new summits, new perspectives. The Summaverse expanded to embrace a wider world — one where every background, every story, and every climb deserves to be heard.</p>
						</div>
					</div>
					<div class="timeline-item">
						<span class="year">Now</span>
						<div class="timeline-body">
							<h3>The Journey Continues</h3>
							<p>Today the Summaverse keeps growing — a universe of ideas, people, and possibilities, all striving toward their own summit. The best chapters are still being written.</p>
						</div>
					</div>
				</section>
			</div>
		</div>

		<Footer />
	</body>
</html>

<style>
	html, body { margin: 0; padding: 0; }

	.page {
		padding-top: 68px;
		min-height: 100vh;
		background: #0a0a0a;
		color: #fff;
	}
	.page-hero {
		text-align: center;
		padding: 5em 2em 3em;
		border-bottom: 1px solid rgba(212, 168, 67, 0.2);
		background: linear-gradient(180deg, #111 0%, #0a0a0a 100%);
	}
	.page-hero h1 {
		color: #fff;
		font-size: clamp(2rem, 5vw, 3.5rem);
		margin: 0 0 0.3em;
		letter-spacing: 0.05em;
	}
	.subtitle {
		color: #d4a843;
		font-size: 0.9em;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin: 0;
	}
	.content {
		max-width: 820px;
		margin: 0 auto;
		padding: 5em 2em 6em;
	}
	.timeline {
		display: flex;
		flex-direction: column;
		gap: 0;
	}
	.timeline-item {
		display: flex;
		gap: 2.5em;
		align-items: flex-start;
		padding-bottom: 3.5em;
		position: relative;
	}
	.timeline-item:not(:last-child)::before {
		content: '';
		position: absolute;
		left: 52px;
		top: 1.6em;
		bottom: 0;
		width: 1px;
		background: rgba(212, 168, 67, 0.2);
	}
	.year {
		font-size: 1em;
		font-weight: 700;
		color: #d4a843;
		min-width: 60px;
		padding-top: 0.35em;
		letter-spacing: 0.05em;
		flex-shrink: 0;
	}
	.timeline-body h3 {
		color: #fff;
		margin: 0 0 0.6em;
		font-size: 1.3em;
		letter-spacing: 0.02em;
	}
	.timeline-body p {
		color: #999;
		margin: 0;
		line-height: 1.8;
		font-size: 0.95em;
	}

	@media (max-width: 600px) {
		.timeline-item { gap: 1.5em; }
		.timeline-item:not(:last-child)::before { left: 36px; }
		.year { min-width: 44px; font-size: 0.85em; }
	}
</style>
